<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Native PHP API. The route is passed as a query parameter so the same
  # front controller works on Apache and PHP's built-in development server.
  RewriteRule ^api/?$ api/index.php [L,QSA]
  RewriteRule ^api/(.*)$ api/index.php?path=$1 [L,QSA]

  # Vite's React SPA fallback.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_mime.c>
  # PDF.js runs as a module worker in the browser. Explicit MIME mappings
  # keep the reader working on shared Apache hosting where .mjs is unknown.
  AddType application/javascript .mjs
  AddType application/pdf .pdf
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Vite fingerprints JavaScript/CSS and font filenames. Keep those immutable
  # so repeat visits do not download the application shell again.
  <FilesMatch "\.(js|mjs|css|woff|woff2|ttf|otf|svg)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Media is intentionally revalidated weekly because its filenames are not
  # generated by the bundler and may be replaced without a new build hash.
  <FilesMatch "\.(png|jpe?g|webp|avif|gif|mp4|webm)$">
    Header always set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Editorial PPTX filenames are server-generated immutable IDs, so learner
  # revisits can reuse a downloaded presentation rather than fetch it again.
  <FilesMatch "\.pptx$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The HTML entry point and manifest must be checked for new deploys.
  <FilesMatch "^(index\.html|manifest\.json)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Never expose local database/config artifacts if they are placed under the
# document root during development.
<FilesMatch "\.(sqlite|sqlite3|db|env|local\.php)$">
  Require all denied
</FilesMatch>
